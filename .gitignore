# --- R Environment & IDE Files ---
.Rhistory
.RData
.Ruserdata
.Rproj.user/
.Rapp.history
.RDataTmp
*.Rproj

# --- System Junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Large Binary/Data Files (Global Ignore) ---
# Prevents uploading files that exceed GitHub's 100MB limit
*.rds
*.Rdata
*.RData
*.rda
*.h5
*.gz
*.tar
*.mtx
*.zip
*.7z

# --- Folder Specific Rules ---

# 1. Raw_Data: Ignore data but keep the folder structure
Raw_Data/**/*
!Raw_Data/**/
!Raw_Data/**/.gitkeep

# 2. Processed_Objects: Keep the folder structure
Processed_Objects/**/*
!Processed_Objects/**/
!Processed_Objects/**/.gitkeep

# 3. Results: Keep the folder structure
Results/**/*
!Results/**/
!Results/**/.gitkeep

# 4. Environment: Ignore local library but keep the lockfile
Environment/library/
Environment/python/
Environment/staging/

# --- Essential Exceptions (must stay at the END of the file) ---

# Scripts and documentation
!*.R
!*.Rmd
!*.md
!LICENSE

# Small reference files required for analysis
!External_Data_File/biomart_chicken_human_raw.txt
!External_Data_File/orthologs_ALL_ensembl111.tsv
!External_Data_File/orthologs_one2one_ensembl111.tsv
!External_Data_File/Richard2016_Bulk_T2EC.csv
!External_Data_File/Immature_Ery.csv
!External_Data_File/Mature_Ery.csv

# Environment reproducibility files
!Environment/session_info.txt
!Environment/renv.lock
!Environment/activate.R
!Environment/settings.json